# Copia questo file in .env.supabase e compilalo: lo usano solo i comandi pnpm db:remote:*.
# Gli stessi valori vanno in Vercel → Settings → Environment Variables.
# Non usare .env.local: pnpm dev lo legge e l'app in locale passerebbe al database online.

# Supabase → Connect → "Transaction pooler" (porta 6543). Sostituisci [YOUR-PASSWORD] con la password del database.
DATABASE_URL=

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Metti 1 quando il provider Google è attivo in Supabase (Authentication → Sign In / Providers)
NEXT_PUBLIC_AUTH_GOOGLE=

# Google Cloud → progetto somaspace-crm → Google Auth Platform → Client → "Somaspace CRM web"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cifra i token di Google nel database: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Protegge la sincronizzazione automatica (Vercel Cron la manda da sola): una stringa casuale lunga
CRON_SECRET=
